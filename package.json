  "dependencies": {
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "ai": "7.0.109",
    "mongoose": "9.10.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true,
    "esbuild@0.28.2": true
  }
