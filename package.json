{
  "name": "planroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --import ./scripts/eslint-typescript6.mjs ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
